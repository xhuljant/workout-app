# Keep line endings sane across Windows / macOS / Linux.
# Anything that runs inside the Linux containers (or in git-bash / WSL) MUST be
# LF, or the shebang breaks with "no such file or directory".

* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.mako      text eol=lf

# Binary-ish: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dump binary
