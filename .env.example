# Copy this file to ".env" (in the same folder) and change the values.
#   cp .env.example .env
# docker-compose reads ".env" automatically.

# --- PostgreSQL ---
POSTGRES_USER=workout
POSTGRES_PASSWORD=change-me-to-something-secret
POSTGRES_DB=workout

# --- API ---
# A long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-value

# --- Password reset / email ---
# How long an emailed reset link stays valid, in minutes.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Public origin of the app, used to build the reset link. No trailing slash.
APP_BASE_URL=http://localhost:8000
# SMTP: if SMTP_HOST is blank, reset emails are written to the API log instead
# of being sent (fine for local dev; set these in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Workout Log <no-reply@example.com>
SMTP_TLS=true
