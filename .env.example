# Copy this file to ".env" (in the same folder) and change the values.
#   cp .env.example .env
# docker-compose reads ".env" automatically.

# --- PostgreSQL ---
POSTGRES_USER=workout
POSTGRES_PASSWORD=change-me-to-something-secret
POSTGRES_DB=workout

# --- API ---
# A long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-long-random-value

# --- Web Push (optional) ---
# Powers "notify me when the rest timer ends" while the app is backgrounded.
# Leave these unset to disable the feature entirely.
#
# Generate a VAPID keypair (needs the `pywebpush` deps, so run it inside the
# container after a build):
#   docker compose run --rm --entrypoint "" api python -c "\
#import base64; from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); \
#pub=v.public_key.public_bytes(2,4); \
#prv=v.private_key.private_numbers().private_value.to_bytes(32,'big'); \
#b64=lambda b: base64.urlsafe_b64encode(b).decode().rstrip('='); \
#print('VAPID_PUBLIC_KEY='+b64(pub)); print('VAPID_PRIVATE_KEY='+b64(prv))"
# (or `npx web-push generate-vapid-keys`).
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# A contact the push service can reach about your deployment.
VAPID_SUBJECT=mailto:you@example.com
